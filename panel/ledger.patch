+import { describe, expect, test } from 'bun:test';
+import type { TFunction } from 'i18next';
+import {
+  buildLedgerWindows,
+  ledgerPlanLabel,
+  orderRowWindows,
+  summarizeProvider,
+  type LedgerWindow,
+} from '@/features/quota/ledgerModel';
+
+const t = ((key: string) => key) as unknown as TFunction;
+const NOW = Date.UTC(2026, 8, 11, 12, 0, 0);
+const HOUR = 3_600_000;
+
+const claudeQuota = (fable: number | null, fiveHour: number, sevenDay: number) => ({
+  status: 'success',
+  planType: 'plan_max',
+  windows: [
+    {
+      id: 'five-hour',
+      label: '5-hour',
+      labelKey: 'claude_quota.five_hour',
+      usedPercent: fiveHour,
+      resetLabel: '',
+      resetAtMs: NOW + 3 * HOUR,
+    },
+    {
+      id: 'seven-day',
+      label: '7-day',
+      labelKey: 'claude_quota.seven_day',
+      usedPercent: sevenDay,
+      resetLabel: '',
+      resetAtMs: NOW + 48 * HOUR,
+    },
+    {
+      id: 'seven-day-fable',
+      label: 'Fable',
+      labelKey: 'claude_quota.seven_day_fable',
+      usedPercent: fable,
+      resetLabel: '',
+      resetAtMs: NOW + 24 * HOUR,
+    },
+  ],
+});
+
+const win = (
+  key: string,
+  remaining: number | null,
+  resetAtMs: number | null = null
+): LedgerWindow => ({
+  key,
+  label: key,
+  remaining,
+  resetAtMs,
+});
+
+describe('buildLedgerWindows', () => {
+  test('returns nothing until quota has loaded', () => {
+    expect(buildLedgerWindows('claude', undefined, t)).toEqual([]);
+    expect(buildLedgerWindows('claude', { status: 'loading' }, t)).toEqual([]);
+    expect(buildLedgerWindows('claude', { status: 'error' }, t)).toEqual([]);
+  });
+
+  test('turns percent used into percent remaining, clamped', () => {
+    const windows = buildLedgerWindows('claude', claudeQuota(42, -5, 130), t);
+    expect(windows.map((window) => [window.key, window.label, window.remaining])).toEqual([
+      ['five-hour', 'claude_quota.five_hour', 100],
+      ['seven-day', 'claude_quota.seven_day', 0],
+      ['seven-day-fable', 'claude_quota.seven_day_fable', 58],
+    ]);
+  });
+
+  test('keeps an unreported usage as null rather than full', () => {
+    const [, , fable] = buildLedgerWindows('claude', claudeQuota(null, 0, 0), t);
+    expect(fable.remaining).toBeNull();
+  });
+
+  test('antigravity reports the fraction remaining', () => {
+    const windows = buildLedgerWindows(
+      'antigravity',
+      {
+        status: 'success',
+        groups: [
+          { buckets: [{ id: 'g', label: 'Gemini', remainingFraction: 0.256, resetAtMs: NOW }] },
+        ],
+      } as never,
+      t
+    );
+    expect(windows).toEqual([{ key: 'g', label: 'Gemini', remaining: 26, resetAtMs: NOW }]);
+  });
+
+  test('kimi derives remaining from counts', () => {
+    const windows = buildLedgerWindows(
+      'kimi',
+      { status: 'success', rows: [{ id: 'w', label: 'Weekly', used: 25, limit: 100 }] } as never,
+      t
+    );
+    expect(windows[0].remaining).toBe(75);
+    expect(windows[0].resetAtMs).toBeNull();
+  });
+
+  test('xai labels the billing period it reports', () => {
+    const weekly = buildLedgerWindows(
+      'xai',
+      {
+        status: 'success',
+        billing: { periodType: 'weekly', usagePercent: 10, resetAtMs: NOW },
+      } as never,
+      t
+    );
+    expect(weekly).toEqual([
+      { key: 'weekly', label: 'xai_quota.weekly_limit', remaining: 90, resetAtMs: NOW },
+    ]);
+    expect(buildLedgerWindows('xai', { status: 'success', billing: null } as never, t)).toEqual([]);
+  });
+
+  test('meta reset instants are unix seconds', () => {
+    const [window] = buildLedgerWindows(
+      'meta',
+      {
+        status: 'success',
+        data: { windows: [{ id: 'weekly', usedPercent: 40, resetAt: 1000 }] },
+      } as never,
+      t
+    );
+    expect(window).toEqual({
+      key: 'weekly',
+      label: 'meta_quota.weekly',
+      remaining: 60,
+      resetAtMs: 1_000_000,
+    });
+  });
+});
+
+describe('summarizeProvider', () => {
+  test('sums remaining per window over every credential', () => {
+    const summary = summarizeProvider(
+      'claude',
+      [claudeQuota(42, 0, 21), claudeQuota(0, 0, 0), claudeQuota(49, 1, 25)].map((quota) =>
+        buildLedgerWindows('claude', quota, t)
+      ),
+      NOW
+    );
+    const fable = summary.windows.find((window) => window.key === 'seven-day-fable');
+    expect(summary.credentials).toBe(3);
+    expect(fable?.total).toBe(58 + 100 + 51);
+    expect(fable?.capacity).toBe(300);
+    expect(fable?.segments).toEqual([58, 100, 51]);
+  });
+
+  test('puts the tightest window first', () => {
+    const summary = summarizeProvider(
+      'claude',
+      [claudeQuota(42, 0, 21), claudeQuota(49, 1, 25)].map((quota) =>
+        buildLedgerWindows('claude', quota, t)
+      ),
+      NOW
+    );
+    expect(summary.windows.map((window) => window.key)).toEqual([
+      'seven-day-fable',
+      'seven-day',
+      'five-hour',
+    ]);
+  });
+
+  test('counts unloaded credentials in capacity as empty segments', () => {
+    const summary = summarizeProvider('codex', [[win('weekly', 17)], [], []], NOW);
+    expect(summary.windows[0]).toMatchObject({
+      total: 17,
+      capacity: 300,
+      segments: [17, null, null],
+    });
+  });
+
+  test('reports no windows when nothing has loaded', () => {
+    const summary = summarizeProvider('xai', [[]], NOW);
+    expect(summary).toEqual({ type: 'xai', credentials: 1, windows: [] });
+  });
+
+  test('a window nobody reported a number for sinks below measured ones', () => {
+    const summary = summarizeProvider('kimi', [[win('a', null), win('b', 90)]], NOW);
+    expect(summary.windows.map((window) => [window.key, window.total])).toEqual([
+      ['b', 90],
+      ['a', null],
+    ]);
+  });
+
+  test('next reset is the soonest one still ahead', () => {
+    const summary = summarizeProvider(
+      'codex',
+      [
+        [win('weekly', 50, NOW - HOUR)],
+        [win('weekly', 50, NOW + 5 * HOUR)],
+        [win('weekly', 50, NOW + 2 * HOUR)],
+      ],
+      NOW
+    );
+    expect(summary.windows[0].nextResetAtMs).toBe(NOW + 2 * HOUR);
+  });
+});
+
+describe('orderRowWindows', () => {
+  test('moves the binding window first and keeps the rest in order', () => {
+    const windows = [win('a', 1), win('b', 2), win('c', 3)];
+    expect(orderRowWindows(windows, 'c').map((window) => window.key)).toEqual(['c', 'a', 'b']);
+    expect(orderRowWindows(windows, null)).toBe(windows);
+    expect(orderRowWindows(windows, 'missing').map((window) => window.key)).toEqual([
+      'a',
+      'b',
+      'c',
+    ]);
+  });
+});
+
+describe('ledgerPlanLabel', () => {
+  test('names claude and codex plans', () => {
+    expect(ledgerPlanLabel('claude', claudeQuota(0, 0, 0), t)).toBe('claude_quota.plan_max');
+    expect(ledgerPlanLabel('codex', { status: 'success', planType: 'plus' } as never, t)).toBe(
+      'codex_quota.plan_plus'
+    );
+    expect(ledgerPlanLabel('codex', { status: 'success', planType: 'pro' } as never, t)).toBe(
+      'codex_quota.plan_pro'
+    );
+  });
+
+  test('stays empty without loaded quota or a plan', () => {
+    expect(ledgerPlanLabel('claude', { status: 'idle' }, t)).toBeNull();
+    expect(ledgerPlanLabel('kimi', { status: 'success' }, t)).toBeNull();
+  });
+});
