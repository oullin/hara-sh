diff --git a/src/features/quota/components/QuotaLedger.module.scss b/src/features/quota/components/QuotaLedger.module.scss
new file mode 100644
index 0000000..05276b1
--- /dev/null
+++ b/src/features/quota/components/QuotaLedger.module.scss
@@ -0,0 +1,486 @@
+@use '../../../styles/mixins' as *;
+
+/* ============================================================
+ * Ledger view: provider totals strip + per-credential rows.
+ * Telemetry is mono + tabular-nums, same as the cards.
+ * ============================================================ */
+
+.ledger {
+  display: flex;
+  flex-direction: column;
+  gap: 28px;
+  min-width: 0;
+}
+
+/* ---------- tones (shared by segments and meters) ---------- */
+
+.toneHigh {
+  background: var(--viz-success);
+}
+
+.toneMedium {
+  background: var(--quota-medium-color);
+}
+
+.toneLow {
+  background: var(--viz-failure);
+}
+
+.toneNone {
+  background: transparent;
+}
+
+/* ---------- summary strip ---------- */
+
+.summaryStrip {
+  display: grid;
+  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
+  border: 1px solid var(--border-color);
+  border-radius: 14px;
+  background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
+  overflow: hidden;
+}
+
+.summaryCard {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  min-width: 0;
+  padding: 18px 20px 16px;
+  /* Hairline dividers that still work when the grid wraps. */
+  box-shadow:
+    1px 0 0 0 var(--border-color),
+    0 1px 0 0 var(--border-color);
+}
+
+.summaryHead {
+  display: flex;
+  align-items: center;
+  gap: 10px;
+  min-width: 0;
+  margin-bottom: 8px;
+}
+
+.providerIcon {
+  flex-shrink: 0;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 22px;
+  height: 22px;
+  border-radius: 6px;
+
+  img {
+    width: 16px;
+    height: 16px;
+    object-fit: contain;
+    display: block;
+  }
+
+  span {
+    font-size: 11px;
+    font-weight: 700;
+    color: var(--text-secondary);
+  }
+}
+
+.summaryName {
+  flex: 1 1 auto;
+  min-width: 0;
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--text-primary);
+  @include text-ellipsis;
+}
+
+.summaryCount {
+  flex-shrink: 0;
+  font-size: 13px;
+  color: var(--text-tertiary);
+}
+
+.summaryLabel {
+  font-size: 13px;
+  color: var(--text-secondary);
+  @include text-ellipsis;
+}
+
+.summaryFigure {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  min-width: 0;
+}
+
+.summaryTotal {
+  font-size: 28px;
+  font-weight: 650;
+  line-height: 1.15;
+  letter-spacing: -0.01em;
+  color: var(--text-primary);
+  font-variant-numeric: tabular-nums;
+}
+
+.summaryCapacity {
+  font-size: 13px;
+  color: var(--text-tertiary);
+  font-variant-numeric: tabular-nums;
+}
+
+.segments {
+  display: flex;
+  gap: 6px;
+  margin: 6px 0 4px;
+}
+
+.segment {
+  position: relative;
+  flex: 1 1 0;
+  min-width: 0;
+  height: 4px;
+  border-radius: $radius-full;
+  background: color-mix(in srgb, var(--text-primary) 10%, transparent);
+  overflow: hidden;
+}
+
+.segmentFill {
+  position: absolute;
+  inset: 0 auto 0 0;
+  border-radius: inherit;
+  transition: width 360ms var(--ease-out-strong, ease);
+}
+
+.summaryMore {
+  display: flex;
+  align-items: center;
+  flex-wrap: wrap;
+  gap: 6px 14px;
+  margin-top: 10px;
+  padding-top: 12px;
+  border-top: 1px solid var(--border-color);
+}
+
+.summaryMoreRow {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.summaryMoreLabel {
+  font-size: 13px;
+  color: var(--text-secondary);
+  @include text-ellipsis;
+}
+
+.summaryMoreValue {
+  font-size: 13px;
+  font-weight: 600;
+  color: var(--text-primary);
+  font-variant-numeric: tabular-nums;
+}
+
+.summaryToggle {
+  @include button-reset;
+  margin-left: auto;
+  font-size: 13px;
+  color: var(--text-tertiary);
+  cursor: pointer;
+
+  &:hover {
+    color: var(--text-primary);
+  }
+
+  &:focus-visible {
+    outline: 2px solid var(--primary-color);
+    outline-offset: 2px;
+    border-radius: 4px;
+  }
+}
+
+/* ---------- reset line ---------- */
+
+.reset {
+  display: inline-flex;
+  align-items: baseline;
+  gap: 0;
+  min-width: 0;
+  font-size: 12.5px;
+  color: var(--text-tertiary);
+  font-variant-numeric: tabular-nums;
+  white-space: nowrap;
+  overflow: hidden;
+  text-overflow: ellipsis;
+}
+
+.resetRelative {
+  color: var(--text-secondary);
+}
+
+.resetAbsolute::before {
+  content: '·';
+  margin: 0 6px;
+}
+
+/* ---------- groups ---------- */
+
+.group {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+}
+
+.groupTitle {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  margin: 0 0 6px;
+  font-size: 15px;
+  font-weight: 600;
+  color: var(--text-primary);
+}
+
+.groupCount {
+  font-size: 13px;
+  font-weight: 400;
+  color: var(--text-tertiary);
+  font-variant-numeric: tabular-nums;
+}
+
+.rows {
+  display: flex;
+  flex-direction: column;
+}
+
+.row {
+  display: grid;
+  grid-template-columns: minmax(180px, 1.3fr) minmax(0, 3fr) 136px;
+  align-items: center;
+  gap: 16px 28px;
+  padding: 16px 0;
+  border-bottom: 1px solid var(--border-color);
+
+  &:last-child {
+    border-bottom: 0;
+  }
+
+  @media (max-width: #{$breakpoint-tablet}) {
+    grid-template-columns: minmax(0, 1fr) auto;
+
+    .cells {
+      grid-column: 1 / -1;
+      grid-row: 2;
+    }
+  }
+}
+
+.identity {
+  display: flex;
+  flex-direction: column;
+  gap: 4px;
+  min-width: 0;
+}
+
+.fileName {
+  font-family: $font-mono;
+  font-size: 13.5px;
+  font-weight: 600;
+  color: var(--text-primary);
+  @include text-ellipsis;
+}
+
+.plan {
+  font-size: 12.5px;
+  color: var(--text-tertiary);
+}
+
+.cells {
+  display: grid;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+  gap: 12px 24px;
+  min-width: 0;
+
+  @include mobile {
+    grid-template-columns: minmax(0, 1fr);
+  }
+}
+
+.cell {
+  display: flex;
+  flex-direction: column;
+  gap: 7px;
+  min-width: 0;
+}
+
+.cellHead {
+  display: flex;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 8px;
+  min-width: 0;
+}
+
+.cellLabel {
+  font-size: 13px;
+  color: var(--text-secondary);
+  @include text-ellipsis;
+}
+
+.cellPercent {
+  flex-shrink: 0;
+  font-size: 14px;
+  font-weight: 650;
+  color: var(--text-primary);
+  font-variant-numeric: tabular-nums;
+}
+
+.meter {
+  position: relative;
+  height: 4px;
+  border-radius: $radius-full;
+  background: color-mix(in srgb, var(--text-primary) 10%, transparent);
+  overflow: hidden;
+}
+
+.meterFill {
+  position: absolute;
+  inset: 0 auto 0 0;
+  border-radius: inherit;
+  transition: width 360ms var(--ease-out-strong, ease);
+}
+
+.cellSkeleton {
+  display: flex;
+  flex-direction: column;
+  gap: 9px;
+
+  span {
+    display: block;
+    height: 10px;
+    border-radius: 4px;
+    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
+    animation: ledger-pulse 1.2s ease-in-out infinite;
+  }
+
+  span:nth-child(1) {
+    width: 70%;
+  }
+
+  span:nth-child(2) {
+    height: 4px;
+  }
+
+  span:nth-child(3) {
+    width: 55%;
+  }
+}
+
+@keyframes ledger-pulse {
+  50% {
+    opacity: 0.45;
+  }
+}
+
+.idle {
+  @include button-reset;
+  grid-column: 1 / -1;
+  justify-self: start;
+  font-size: 13px;
+  color: var(--text-tertiary);
+  cursor: pointer;
+
+  &:hover:not(:disabled) {
+    color: var(--text-primary);
+  }
+
+  &:disabled {
+    cursor: not-allowed;
+  }
+
+  &:focus-visible {
+    outline: 2px solid var(--primary-color);
+    outline-offset: 2px;
+    border-radius: 4px;
+  }
+}
+
+.error,
+.empty {
+  grid-column: 1 / -1;
+  font-size: 13px;
+  color: var(--text-tertiary);
+}
+
+.error {
+  color: var(--error-color);
+}
+
+.actions {
+  display: flex;
+  justify-content: flex-end;
+  min-width: 0;
+}
+
+.refresh {
+  @include button-reset;
+  display: inline-flex;
+  align-items: center;
+  gap: 6px;
+  padding: 6px 8px;
+  border-radius: 8px;
+  font-size: 13px;
+  color: var(--text-tertiary);
+  white-space: nowrap;
+  cursor: pointer;
+  transition: color var(--dur-hover, 200ms) ease;
+
+  &:hover:not(:disabled) {
+    color: var(--text-primary);
+    background: var(--bg-hover);
+  }
+
+  &:disabled {
+    opacity: 0.5;
+    cursor: not-allowed;
+  }
+
+  &:focus-visible {
+    outline: 2px solid var(--primary-color);
+    outline-offset: 1px;
+  }
+}
+
+.spinning {
+  animation: ledger-spin 0.9s linear infinite;
+}
+
+@keyframes ledger-spin {
+  to {
+    transform: rotate(360deg);
+  }
+}
+
+.srOnly {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .segmentFill,
+  .meterFill {
+    transition: none;
+  }
+
+  .spinning,
+  .cellSkeleton span {
+    animation: none;
+  }
+}
diff --git a/src/features/quota/components/QuotaLedger.tsx b/src/features/quota/components/QuotaLedger.tsx
new file mode 100644
index 0000000..62b6c92
--- /dev/null
+++ b/src/features/quota/components/QuotaLedger.tsx
@@ -0,0 +1,412 @@
+/**
+ * Ledger view: provider totals on top, one row per credential below.
+ *
+ * The card grid answers "what does this credential look like"; the ledger
+ * answers "how much is left across the pool, and where". Credentials line up
+ * in columns, binding window first, so a glance down a column compares them.
+ * Loading stays click-to-fetch, same as the cards.
+ */
+
+import { Fragment, useMemo, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+import type { TFunction } from 'i18next';
+import { IconRefreshCw } from '@/components/ui/icons';
+import { useNow } from '@/hooks/useNow';
+import type { ResolvedTheme } from '@/types';
+import { formatInstantShort, formatRelativeInstant, resolveQuotaErrorMessage } from '@/utils/quota';
+import { getQuotaCacheKey, getQuotaDisplayName } from '@/utils/quota/identity';
+import {
+  getAuthFileIcon,
+  getThemeSurfaceIconBackground,
+  getTypeLabel,
+  isThemeSurfaceIconProvider,
+} from '@/features/authFiles/constants';
+import { QUOTA_TAB_ORDER } from '../constants';
+import { isQuotaRefreshDisabled, type QuotaFileEntry } from '../logic';
+import {
+  buildLedgerWindows,
+  ledgerPlanLabel,
+  orderRowWindows,
+  summarizeProvider,
+  type LedgerProviderSummary,
+  type LedgerSummaryWindow,
+  type LedgerWindow,
+} from '../ledgerModel';
+import { QUOTA_ADAPTERS, type QuotaCardState } from '../providers';
+import { QUOTA_PROGRESS_HIGH_THRESHOLD, QUOTA_PROGRESS_MEDIUM_THRESHOLD } from './QuotaMeter';
+import type { QuotaProviderType } from '../providers/types';
+import styles from './QuotaLedger.module.scss';
+
+/** Windows shown per row; anything past this is in the card view. */
+const ROW_WINDOW_LIMIT = 3;
+
+export type QuotaLedgerProps = {
+  /** Every credential in the current tab and search: the totals cover all of them. */
+  entries: QuotaFileEntry[];
+  /** The current page: the rows. */
+  pageEntries: QuotaFileEntry[];
+  quotaFor: (entry: QuotaFileEntry) => QuotaCardState | undefined;
+  resolvedTheme: ResolvedTheme;
+  canRefresh: boolean;
+  resettingName: string | null;
+  onRefresh: (entry: QuotaFileEntry) => void;
+};
+
+const toneClass = (percent: number | null): string => {
+  if (percent === null) return styles.toneNone;
+  if (percent >= QUOTA_PROGRESS_HIGH_THRESHOLD) return styles.toneHigh;
+  if (percent >= QUOTA_PROGRESS_MEDIUM_THRESHOLD) return styles.toneMedium;
+  return styles.toneLow;
+};
+
+const formatPercent = (value: number | null) => (value === null ? '--' : `${Math.round(value)}%`);
+
+function ResetLine({
+  atMs,
+  now,
+  locale,
+  t,
+}: {
+  atMs: number | null;
+  now: number;
+  locale?: string;
+  t: TFunction;
+}) {
+  if (atMs === null || atMs <= now) {
+    return <span className={styles.reset}>{t('quota_ledger.no_reset')}</span>;
+  }
+  return (
+    <span className={styles.reset}>
+      <span className={styles.resetRelative}>{formatRelativeInstant(atMs, now, locale)}</span>
+      <span className={styles.resetAbsolute}>{formatInstantShort(atMs)}</span>
+    </span>
+  );
+}
+
+function ProviderIcon({
+  type,
+  resolvedTheme,
+  t,
+}: {
+  type: QuotaProviderType;
+  resolvedTheme: ResolvedTheme;
+  t: TFunction;
+}) {
+  const src = getAuthFileIcon(type, resolvedTheme);
+  const label = getTypeLabel(t, type);
+  return (
+    <span
+      className={styles.providerIcon}
+      style={
+        isThemeSurfaceIconProvider(type)
+          ? { background: getThemeSurfaceIconBackground(resolvedTheme) }
+          : undefined
+      }
+    >
+      {src ? <img src={src} alt="" /> : <span>{label.slice(0, 1).toUpperCase()}</span>}
+    </span>
+  );
+}
+
+function SummaryCard({
+  summary,
+  resolvedTheme,
+  now,
+}: {
+  summary: LedgerProviderSummary;
+  resolvedTheme: ResolvedTheme;
+  now: number;
+}) {
+  const { t, i18n } = useTranslation();
+  const [expanded, setExpanded] = useState(false);
+  const [lead, ...rest] = summary.windows;
+  const shown = expanded ? rest : rest.slice(0, 1);
+  const hidden = rest.length - 1;
+
+  const capacityLabel = t('quota_ledger.of_capacity', { capacity: summary.credentials * 100 });
+
+  return (
+    <article className={styles.summaryCard}>
+      <header className={styles.summaryHead}>
+        <ProviderIcon type={summary.type} resolvedTheme={resolvedTheme} t={t} />
+        <span className={styles.summaryName}>{getTypeLabel(t, summary.type)}</span>
+        <span className={styles.summaryCount}>
+          {t('quota_ledger.credentials', { count: summary.credentials })}
+        </span>
+      </header>
+
+      {lead ? (
+        <>
+          <div className={styles.summaryLabel}>{lead.label}</div>
+          <div className={styles.summaryFigure}>
+            <span className={styles.summaryTotal}>{formatPercent(lead.total)}</span>
+            <span className={styles.summaryCapacity}>{capacityLabel}</span>
+          </div>
+          <SegmentBar window={lead} />
+          <ResetLine atMs={lead.nextResetAtMs} now={now} locale={i18n.resolvedLanguage} t={t} />
+        </>
+      ) : (
+        <>
+          <div className={styles.summaryLabel}>{t('quota_ledger.not_loaded')}</div>
+          <div className={styles.summaryFigure}>
+            <span className={styles.summaryTotal}>--</span>
+            <span className={styles.summaryCapacity}>{capacityLabel}</span>
+          </div>
+          <SegmentBar window={null} credentials={summary.credentials} />
+        </>
+      )}
+
+      {rest.length > 0 && (
+        <div className={styles.summaryMore}>
+          {shown.map((window) => (
+            <div key={window.key} className={styles.summaryMoreRow}>
+              <span className={styles.summaryMoreLabel}>{window.label}</span>
+              <span className={styles.summaryMoreValue}>{formatPercent(window.total)}</span>
+            </div>
+          ))}
+          {hidden > 0 && (
+            <button
+              type="button"
+              className={styles.summaryToggle}
+              aria-expanded={expanded}
+              onClick={() => setExpanded((value) => !value)}
+            >
+              {expanded ? t('quota_ledger.hide') : t('quota_ledger.show')}
+            </button>
+          )}
+        </div>
+      )}
+    </article>
+  );
+}
+
+function SegmentBar({
+  window,
+  credentials = 0,
+}: {
+  window: LedgerSummaryWindow | null;
+  credentials?: number;
+}) {
+  const segments = window ? window.segments : Array.from({ length: credentials }, () => null);
+  return (
+    <div className={styles.segments} aria-hidden="true">
+      {segments.map((value, index) => (
+        <span key={index} className={styles.segment}>
+          <span
+            className={`${styles.segmentFill} ${toneClass(value)}`}
+            style={{ width: `${value ?? 0}%` }}
+          />
+        </span>
+      ))}
+    </div>
+  );
+}
+
+function WindowCell({
+  window,
+  now,
+  locale,
+  t,
+}: {
+  window: LedgerWindow;
+  now: number;
+  locale?: string;
+  t: TFunction;
+}) {
+  return (
+    <div className={styles.cell}>
+      <div className={styles.cellHead}>
+        <span className={styles.cellLabel} title={window.label}>
+          {window.label}
+        </span>
+        <span className={styles.cellPercent}>{formatPercent(window.remaining)}</span>
+      </div>
+      <div
+        className={styles.meter}
+        role={window.remaining === null ? undefined : 'meter'}
+        aria-label={window.label}
+        aria-valuemin={window.remaining === null ? undefined : 0}
+        aria-valuemax={window.remaining === null ? undefined : 100}
+        aria-valuenow={window.remaining ?? undefined}
+      >
+        <span
+          className={`${styles.meterFill} ${toneClass(window.remaining)}`}
+          style={{ width: `${window.remaining ?? 0}%` }}
+        />
+      </div>
+      <ResetLine atMs={window.resetAtMs} now={now} locale={locale} t={t} />
+    </div>
+  );
+}
+
+export function QuotaLedger({
+  entries,
+  pageEntries,
+  quotaFor,
+  resolvedTheme,
+  canRefresh,
+  resettingName,
+  onRefresh,
+}: QuotaLedgerProps) {
+  const { t, i18n } = useTranslation();
+  const now = useNow();
+  const locale = i18n.resolvedLanguage;
+
+  const summaries = useMemo(() => {
+    const byType = new Map<QuotaProviderType, LedgerWindow[][]>();
+    entries.forEach((entry) => {
+      const list = byType.get(entry.type) ?? [];
+      list.push(buildLedgerWindows(entry.type, quotaFor(entry), t));
+      byType.set(entry.type, list);
+    });
+    return QUOTA_TAB_ORDER.filter((type) => byType.has(type)).map((type) =>
+      summarizeProvider(type, byType.get(type) ?? [], now)
+    );
+  }, [entries, quotaFor, t, now]);
+
+  const leadKeyByType = useMemo(
+    () =>
+      new Map<QuotaProviderType, string | null>(
+        summaries.map((summary) => [summary.type, summary.windows[0]?.key ?? null])
+      ),
+    [summaries]
+  );
+
+  // Rows group by provider in tab order; within a group the incoming order
+  // (default or soonest-recovery) is kept.
+  const groups = useMemo(() => {
+    const byType = new Map<QuotaProviderType, QuotaFileEntry[]>();
+    pageEntries.forEach((entry) => {
+      const list = byType.get(entry.type) ?? [];
+      list.push(entry);
+      byType.set(entry.type, list);
+    });
+    return QUOTA_TAB_ORDER.filter((type) => byType.has(type)).map((type) => ({
+      type,
+      rows: byType.get(type) ?? [],
+      total: entries.filter((entry) => entry.type === type).length,
+    }));
+  }, [entries, pageEntries]);
+
+  return (
+    <div className={styles.ledger}>
+      {summaries.length > 0 && (
+        <section className={styles.summaryStrip} aria-label={t('quota_ledger.summary_label')}>
+          {summaries.map((summary) => (
+            <SummaryCard
+              key={summary.type}
+              summary={summary}
+              resolvedTheme={resolvedTheme}
+              now={now}
+            />
+          ))}
+        </section>
+      )}
+
+      {groups.map((group) => (
+        <section key={group.type} className={styles.group}>
+          <h3 className={styles.groupTitle}>
+            {getTypeLabel(t, group.type)}
+            <span className={styles.groupCount}>{group.total}</span>
+          </h3>
+          <div className={styles.rows}>
+            {group.rows.map((entry) => {
+              const quota = quotaFor(entry);
+              const status = quota?.status ?? 'idle';
+              const adapter = QUOTA_ADAPTERS[entry.type];
+              const name = getQuotaDisplayName(entry.file);
+              const cacheKey = getQuotaCacheKey(entry.file);
+              const resetting = resettingName === cacheKey;
+              const rowCanRefresh = canRefresh && !entry.file.disabled;
+              const windows = orderRowWindows(
+                buildLedgerWindows(entry.type, quota, t),
+                leadKeyByType.get(entry.type) ?? null
+              ).slice(0, ROW_WINDOW_LIMIT);
+              const plan = ledgerPlanLabel(entry.type, quota, t);
+
+              return (
+                <div key={`${entry.type}:${cacheKey}`} className={styles.row}>
+                  <div className={styles.identity}>
+                    <span className={styles.fileName} title={name}>
+                      {name}
+                    </span>
+                    {plan && <span className={styles.plan}>{plan}</span>}
+                  </div>
+
+                  <div className={styles.cells}>
+                    {status === 'idle' ? (
+                      <button
+                        type="button"
+                        className={styles.idle}
+                        onClick={() => onRefresh(entry)}
+                        disabled={!rowCanRefresh}
+                      >
+                        {t(`${adapter.i18nPrefix}.idle`)}
+                      </button>
+                    ) : status === 'loading' ? (
+                      <Fragment>
+                        <span className={styles.srOnly}>{t(`${adapter.i18nPrefix}.loading`)}</span>
+                        {[0, 1, 2].map((index) => (
+                          <div key={index} className={styles.cellSkeleton} aria-hidden="true">
+                            <span />
+                            <span />
+                            <span />
+                          </div>
+                        ))}
+                      </Fragment>
+                    ) : status === 'error' ? (
+                      <div className={styles.error} role="alert">
+                        {t(`${adapter.i18nPrefix}.load_failed`, {
+                          message: resolveQuotaErrorMessage(
+                            t,
+                            quota?.errorStatus,
+                            quota?.error || t('common.unknown_error')
+                          ),
+                        })}
+                      </div>
+                    ) : windows.length === 0 ? (
+                      <div className={styles.empty}>{t('quota_ledger.no_windows')}</div>
+                    ) : (
+                      windows.map((window) => (
+                        <WindowCell
+                          key={window.key}
+                          window={window}
+                          now={now}
+                          locale={locale}
+                          t={t}
+                        />
+                      ))
+                    )}
+                  </div>
+
+                  <div className={styles.actions}>
+                    {status !== 'idle' && (
+                      <button
+                        type="button"
+                        className={styles.refresh}
+                        onClick={() => onRefresh(entry)}
+                        disabled={isQuotaRefreshDisabled(
+                          rowCanRefresh,
+                          status === 'loading',
+                          resetting
+                        )}
+                        title={t('auth_files.quota_refresh_hint')}
+                      >
+                        <IconRefreshCw
+                          size={13}
+                          aria-hidden="true"
+                          className={status === 'loading' ? styles.spinning : undefined}
+                        />
+                        {t('quota_ledger.refresh')}
+                      </button>
+                    )}
+                  </div>
+                </div>
+              );
+            })}
+          </div>
+        </section>
+      ))}
+    </div>
+  );
+}
