diff --git a/src/features/quota/ledgerModel.ts b/src/features/quota/ledgerModel.ts
new file mode 100644
index 0000000..d2bee2b
--- /dev/null
+++ b/src/features/quota/ledgerModel.ts
@@ -0,0 +1,314 @@
+/**
+ * Ledger view model: every provider's quota flattened to comparable windows.
+ *
+ * The card grid renders each provider in its own shape. The ledger instead
+ * lines credentials up in columns and sums them per provider, so it needs one
+ * shape for all of them: a labelled window with a remaining percent and a reset
+ * instant. React-free; `t` and `now` are injected so every rule is testable.
+ */
+
+import type { TFunction } from 'i18next';
+import { normalizePlanType, PREMIUM_CODEX_PLAN_TYPES, parseIsoToMs } from '@/utils/quota';
+import type { QuotaProviderType } from './providers/types';
+
+/** One quota window of one credential. */
+export interface LedgerWindow {
+  /** Stable across credentials of a provider, so windows can be summed. */
+  key: string;
+  label: string;
+  /** Remaining percent, 0..100; null when the provider reported no usage. */
+  remaining: number | null;
+  resetAtMs: number | null;
+}
+
+/** A window summed over every credential of a provider. */
+export interface LedgerSummaryWindow {
+  key: string;
+  label: string;
+  /** Sum of remaining percent over the credentials reporting this window. */
+  total: number | null;
+  /** 100 per credential of the provider, loaded or not. */
+  capacity: number;
+  /** One value per credential, in credential order; null = not reported. */
+  segments: (number | null)[];
+  /** Soonest upcoming reset across credentials. */
+  nextResetAtMs: number | null;
+}
+
+export interface LedgerProviderSummary {
+  type: QuotaProviderType;
+  credentials: number;
+  /** Ordered tightest first: the first window is the binding limit. */
+  windows: LedgerSummaryWindow[];
+}
+
+type QuotaLike = { status?: string } | undefined;
+
+const clampPercent = (value: number) => Math.min(100, Math.max(0, value));
+
+const remainingFromUsed = (used: unknown): number | null =>
+  typeof used === 'number' && Number.isFinite(used) ? clampPercent(100 - used) : null;
+
+const finiteMs = (value: unknown): number | null =>
+  typeof value === 'number' && Number.isFinite(value) ? value : null;
+
+interface UsedWindowLike {
+  id: string;
+  label?: string;
+  labelKey?: string;
+  labelParams?: Record<string, string | number>;
+  usedPercent?: number | null;
+  resetAtMs?: number | null;
+}
+
+/**
+ * Normalize one credential's quota state.
+ *
+ * Returns an empty list until the quota has loaded successfully: the ledger
+ * shows idle, loading and failed credentials by status, not by windows.
+ */
+export function buildLedgerWindows(
+  provider: QuotaProviderType,
+  quota: QuotaLike,
+  t: TFunction
+): LedgerWindow[] {
+  if (!quota || quota.status !== 'success') return [];
+
+  if (provider === 'claude' || provider === 'codex') {
+    const windows = (quota as { windows?: UsedWindowLike[] }).windows ?? [];
+    return windows.map((window) => ({
+      key: window.id,
+      label: window.labelKey
+        ? String(t(window.labelKey, window.labelParams ?? {}))
+        : (window.label ?? window.id),
+      remaining: remainingFromUsed(window.usedPercent),
+      resetAtMs: finiteMs(window.resetAtMs),
+    }));
+  }
+
+  if (provider === 'devin') {
+    const windows =
+      (
+        quota as {
+          windows?: { id: string; remainingPercent: number | null; resetAtMs: number | null }[];
+        }
+      ).windows ?? [];
+    return windows.map((window) => ({
+      key: window.id,
+      label: String(t(`devin_quota.${window.id}`)),
+      remaining:
+        typeof window.remainingPercent === 'number' ? clampPercent(window.remainingPercent) : null,
+      resetAtMs: finiteMs(window.resetAtMs),
+    }));
+  }
+
+  if (provider === 'xai') {
+    const billing = (
+      quota as {
+        billing?: {
+          periodType?: string;
+          usagePercent?: number | null;
+          resetAtMs?: number | null;
+          billingPeriodEnd?: string;
+        } | null;
+      }
+    ).billing;
+    if (!billing) return [];
+    const weekly = billing.periodType === 'weekly';
+    return [
+      {
+        key: weekly ? 'weekly' : 'monthly',
+        label: String(t(weekly ? 'xai_quota.weekly_limit' : 'xai_quota.monthly_credits')),
+        remaining: remainingFromUsed(billing.usagePercent),
+        resetAtMs: finiteMs(billing.resetAtMs) ?? parseIsoToMs(billing.billingPeriodEnd),
+      },
+    ];
+  }
+
+  if (provider === 'antigravity') {
+    const groups =
+      (
+        quota as {
+          groups?: {
+            buckets?: {
+              id: string;
+              label: string;
+              remainingFraction?: number | null;
+              resetAtMs?: number | null;
+            }[];
+          }[];
+        }
+      ).groups ?? [];
+    return groups
+      .flatMap((group) => group.buckets ?? [])
+      .map((bucket) => ({
+        key: bucket.id,
+        label: bucket.label,
+        remaining:
+          typeof bucket.remainingFraction === 'number'
+            ? clampPercent(Math.round(bucket.remainingFraction * 100))
+            : null,
+        resetAtMs: finiteMs(bucket.resetAtMs),
+      }));
+  }
+
+  if (provider === 'kimi') {
+    const rows =
+      (
+        quota as {
+          rows?: {
+            id: string;
+            label?: string;
+            labelKey?: string;
+            labelParams?: Record<string, string | number>;
+            used: number;
+            limit: number;
+            resetAtMs?: number | null;
+          }[];
+        }
+      ).rows ?? [];
+    return rows.map((row) => ({
+      key: row.id,
+      label: row.labelKey ? String(t(row.labelKey, row.labelParams ?? {})) : (row.label ?? row.id),
+      remaining:
+        row.limit > 0 ? clampPercent(Math.round(((row.limit - row.used) / row.limit) * 100)) : null,
+      resetAtMs: finiteMs(row.resetAtMs),
+    }));
+  }
+
+  if (provider === 'meta') {
+    const windows =
+      (
+        quota as {
+          data?: {
+            windows?: {
+              id: string;
+              usedPercent: number | null;
+              resetAt?: number;
+              durationMinutes?: number;
+            }[];
+          };
+        }
+      ).data?.windows ?? [];
+    return windows.map((window) => ({
+      key: window.id,
+      label:
+        window.id === 'window' && typeof window.durationMinutes === 'number'
+          ? String(t('meta_quota.window_duration', { minutes: window.durationMinutes }))
+          : String(t(`meta_quota.${window.id}`)),
+      remaining: remainingFromUsed(window.usedPercent),
+      resetAtMs: typeof window.resetAt === 'number' ? window.resetAt * 1000 : null,
+    }));
+  }
+
+  return [];
+}
+
+/** Plan name shown under the credential, when the provider reports one. */
+export function ledgerPlanLabel(
+  provider: QuotaProviderType,
+  quota: QuotaLike,
+  t: TFunction
+): string | null {
+  if (!quota || quota.status !== 'success') return null;
+
+  if (provider === 'claude') {
+    const planType = (quota as { planType?: string | null }).planType;
+    return planType ? String(t(`claude_quota.${planType}`)) : null;
+  }
+
+  if (provider === 'codex') {
+    const raw = (quota as { planType?: string | null }).planType;
+    const normalized = normalizePlanType(raw);
+    if (!normalized) return null;
+    if (normalized === 'self_serve_business_prolite') {
+      return String(t('codex_quota.plan_business_premium'));
+    }
+    if (normalized === 'pro') return String(t('codex_quota.plan_pro'));
+    if (PREMIUM_CODEX_PLAN_TYPES.has(normalized)) return String(t('codex_quota.plan_prolite'));
+    if (['plus', 'team', 'free'].includes(normalized)) {
+      return String(t(`codex_quota.plan_${normalized}`));
+    }
+    return raw || normalized;
+  }
+
+  if (provider === 'xai') {
+    const label = (quota as { billing?: { planLabel?: string } | null }).billing?.planLabel;
+    return label ?? null;
+  }
+
+  return null;
+}
+
+/**
+ * Order one credential's windows for its row: the provider's binding window
+ * first, the rest in the order the provider reported them.
+ */
+export function orderRowWindows(windows: LedgerWindow[], leadKey: string | null): LedgerWindow[] {
+  if (!leadKey) return windows;
+  const lead = windows.filter((window) => window.key === leadKey);
+  return [...lead, ...windows.filter((window) => window.key !== leadKey)];
+}
+
+/**
+ * Sum every window across a provider's credentials.
+ *
+ * `windowsPerCredential` has one entry per credential (empty when not loaded),
+ * so the capacity counts every credential and an unloaded one shows as an
+ * empty segment rather than silently shrinking the denominator.
+ */
+export function summarizeProvider(
+  type: QuotaProviderType,
+  windowsPerCredential: LedgerWindow[][],
+  now: number
+): LedgerProviderSummary {
+  const credentials = windowsPerCredential.length;
+  const order: string[] = [];
+  const labels = new Map<string, string>();
+
+  windowsPerCredential.forEach((windows) =>
+    windows.forEach((window) => {
+      if (!labels.has(window.key)) {
+        labels.set(window.key, window.label);
+        order.push(window.key);
+      }
+    })
+  );
+
+  const windows = order.map((key): LedgerSummaryWindow => {
+    let total: number | null = null;
+    let nextResetAtMs: number | null = null;
+    const segments = windowsPerCredential.map((list) => {
+      const window = list.find((candidate) => candidate.key === key);
+      if (!window) return null;
+      if (window.remaining !== null) total = (total ?? 0) + window.remaining;
+      if (
+        window.resetAtMs !== null &&
+        window.resetAtMs > now &&
+        (nextResetAtMs === null || window.resetAtMs < nextResetAtMs)
+      ) {
+        nextResetAtMs = window.resetAtMs;
+      }
+      return window.remaining;
+    });
+    return {
+      key,
+      label: labels.get(key) ?? key,
+      total,
+      capacity: credentials * 100,
+      segments,
+      nextResetAtMs,
+    };
+  });
+
+  // Tightest first: the lowest share of capacity left is what runs out first.
+  // Windows nobody reported a number for sink; ties keep the provider's order.
+  const share = (window: LedgerSummaryWindow) =>
+    window.total === null || window.capacity === 0 ? Infinity : window.total / window.capacity;
+  const ranked = windows
+    .map((window, index) => ({ window, index }))
+    .sort((a, b) => share(a.window) - share(b.window) || a.index - b.index)
+    .map(({ window }) => window);
+
+  return { type, credentials, windows: ranked };
+}
