#!/usr/bin/env bash
# Private client credential, read from local Docker state by default.
# HARA_SECRET_PROVIDER=op reads directly from the optional 1Password CLI.
set -euo pipefail
# shellcheck source=lib/credentials.sh
source "$(dirname "$0")/lib/credentials.sh"

field="${1:-claude-api-key}"
case "$field" in
  claude-api-key|management-password) ;;
  --refresh|--clear) printf 'Use scripts/local.sh import-op to sync 1Password, or make ops keys to rotate local keys.\n' >&2; exit 1 ;;
  *) printf 'unknown credential field\n' >&2; exit 1 ;;
esac

if [[ "${HARA_SECRET_PROVIDER:-file}" == op ]]; then
  exec op read --account "$OP_ACCOUNT" "op://$OP_VAULT/$OP_ITEM_NAME/$field"
fi

repo="$(cd "$(dirname "$0")/.." && pwd)"
LOCAL_DIR="${LOCAL_DIR:-$HOME/.cli-proxy-api}" \
  exec docker compose -f "$repo/local/compose.yaml" run --rm --no-deps -T tools key "$field"
