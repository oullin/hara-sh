{
  "name": "hara-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run docs:build && vite",
    "build": "vue-tsc -b && npm run docs:build && vite build && node scripts/prerender.ts && node scripts/check-seo.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "deploy": "npm run build && vitest run --coverage && cf deploy",
    "docs:dev": "vitepress dev docs --host 127.0.0.1 --port 5174",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-beta.sha-52b0dc0e9",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.3",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "cf": "^1.0.0-beta.12",
    "jsdom": "^30.1.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitepress": "2.0.0-alpha.20",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
