{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "paths": {
      "@docs/*": ["./docs/*"],
      "@worker/*": ["./worker/*"]
    }
  },
  "include": ["worker/**/*.ts", ".cloudflare/types/index.d.ts"]
}
